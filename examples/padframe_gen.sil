// Parametric padframe row -- the class of program that took ~400 lines of
// KLayout pya scripting (plus 11 signoff rounds) in the harvester campaign.
// Every pad placement carries its connectivity declaration; every label is
// checked attached; the spacing assert runs before commit. Off-by-one pitch
// bugs become rollbacks with coordinates, not fab-week discoveries.
//
// Run it:  silica examples/padframe_gen.sil

design "padring.gds" top padring units nm grid 5

stack {
  metal m5 = (35,0)
  metal m6 = (36,0)
  via   v5 = (55,0) connects (m5,m6)
}

rules {
  m6.width >= 70
  m6.space >= 70
}

invariants { connectivity }

// pad_rf_54x66-inspired footprint: 56x68um bodies on a computed pitch
fn pad(i, pitch) {
  return box(i*pitch, 0, i*pitch + 56000, 68000)
}

let n = 8
let pitch = 60000

tx place_pads {
  for i in range(0, n) {
    add m6 pad(i, pitch) on new_net
    label m6 "PAD_" + str(i) at (i*pitch + 28000, 34000)
  }
  assert spacing(m6, window(0, 0, n*pitch, 68000)) >= 70
}

print("placed " + str(n) + " pads at pitch " + str(pitch) + " nm")
